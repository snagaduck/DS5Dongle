// Haptic audio bridge + low-pass filter
//
// Bridges speaker audio (USB ch1/2) into the haptic actuators with a
// 2nd-order Butterworth LPF at 300Hz, so bass/impact from game audio
// drives the DualSense LRAs without needing external routing software.
//
// To activate: rename this file to haptic_filter.cpp, then re-run cmake.
// To deactivate: rename back to haptic_filter.cpp.disabled, re-run cmake.

#include "haptic_filter.h"
#include <algorithm>

using std::clamp;

// Biquad coefficients — Butterworth LPF, fc=300Hz, fs=48000Hz, Q=1/√2
// w0 = 2π×300/48000, alpha = sin(w0)/(2Q), normalized by a0 = 1+alpha
static constexpr float B0 =  3.75122e-4f;  // b0/a0
static constexpr float B1 =  7.50244e-4f;  // b1/a0
static constexpr float B2 =  3.75122e-4f;  // b2/a0
static constexpr float A1 = -1.94447f;     // a1/a0
static constexpr float A2 =  0.94597f;     // a2/a0

struct BiquadState { float x1, x2, y1, y2; };
static BiquadState states[2]; // one per channel (L, R)

void haptic_filter_process(const int16_t* raw, int raw_nframes, int raw_nch,
                           WDL_ResampleSample* in_buf, int nframes, int out_nch) {
    // Bridge: replace in_buf contents with speaker audio from ch1/2
    int fill = std::min(raw_nframes, nframes);
    for (int i = 0; i < fill; i++) {
        in_buf[i * out_nch + 0] = clamp(raw[i * raw_nch + 0] / 32768.0f, -1.0f, 1.0f);
        in_buf[i * out_nch + 1] = clamp(raw[i * raw_nch + 1] / 32768.0f, -1.0f, 1.0f);
    }
    for (int i = fill; i < nframes; i++) {
        in_buf[i * out_nch + 0] = 0.0f;
        in_buf[i * out_nch + 1] = 0.0f;
    }

    // Filter: 300Hz LPF per channel to pass bass/impact, roll off harshness
    for (int ch = 0; ch < out_nch && ch < 2; ch++) {
        BiquadState& s = states[ch];
        for (int i = 0; i < nframes; i++) {
            float x = (float)in_buf[i * out_nch + ch];
            float y = B0*x + B1*s.x1 + B2*s.x2 - A1*s.y1 - A2*s.y2;
            s.x2 = s.x1; s.x1 = x;
            s.y2 = s.y1; s.y1 = y;
            in_buf[i * out_nch + ch] = (WDL_ResampleSample)y;
        }
    }
}
